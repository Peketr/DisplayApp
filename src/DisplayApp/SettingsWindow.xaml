<Window x:Class="DisplayApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DisplayApp"
        Title="DisplayApp Settings" Width="900" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="70" />
        </Style>
        <Style TargetType="local:HotkeyBox">
            <Setter Property="Width" Value="170" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Preset list -->
        <DockPanel Grid.Row="0" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Presets" Style="{StaticResource SectionHeader}" />
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button Content="New" Click="New_Click" ToolTip="Create a preset from the current layout" MinWidth="0" />
                <Button Content="Duplicate" Click="Duplicate_Click" MinWidth="0" />
                <Button Content="Delete" Click="Delete_Click" MinWidth="0" />
                <Button Content="▲" Click="Up_Click" MinWidth="0" ToolTip="Move up" />
                <Button Content="▼" Click="Down_Click" MinWidth="0" ToolTip="Move down" />
            </WrapPanel>
            <ListBox x:Name="PresetList" ItemsSource="{Binding Presets}" SelectionChanged="PresetList_SelectionChanged"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,3">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Hotkey}" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Preset editor -->
        <Grid Grid.Row="0" Grid.Column="2" x:Name="Editor" DataContext="{Binding SelectedItem, ElementName=PresetList}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Preset" Style="{StaticResource SectionHeader}" />

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" />
                <TextBlock Grid.Column="2" Text="Hotkey" VerticalAlignment="Center" Margin="16,0,8,0" />
                <local:HotkeyBox Grid.Column="3" Hotkey="{Binding Hotkey}" />
                <Button Grid.Column="4" Content="Clear" Margin="6,0,0,0" MinWidth="0" Click="ClearPresetHotkey_Click" />
            </Grid>

            <!-- Layout preview -->
            <Border Grid.Row="2" BorderBrush="#ccc" BorderThickness="1" Background="#f4f4f4" Margin="0,0,0,8">
                <Canvas x:Name="Preview" ClipToBounds="True" SizeChanged="Preview_SizeChanged" />
            </Border>

            <!-- Displays in preset -->
            <ItemsControl Grid.Row="3" ItemsSource="{Binding Displays}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FriendlyName}" />
                            </CheckBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Mode}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Status}" Foreground="#b55" Margin="8,0,0,0" />
                            </StackPanel>
                            <RadioButton Grid.Column="2" Content="Primary" IsChecked="{Binding IsPrimary}"
                                         VerticalAlignment="Center" GroupName="{Binding Key}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                <Button Content="Capture current layout" Click="Capture_Click"
                        ToolTip="Replace this preset's displays with the layout Windows is using right now" />
                <Button Content="Test" Click="Test_Click" ToolTip="Apply now; reverts after 15 seconds unless you keep it" />
            </WrapPanel>
        </Grid>

        <!-- Global hotkeys -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#ddd" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Display toggle hotkeys" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Toggles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                                <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Status}" Foreground="#b55" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <local:HotkeyBox Hotkey="{Binding Hotkey}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="All displays on (panic)" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <local:HotkeyBox Hotkey="{Binding PanicHotkey}" />
                </StackPanel>

                <TextBlock Text="General" Style="{StaticResource SectionHeader}" Margin="0,12,0,6" />
                <WrapPanel>
                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,24,6"
                              VerticalAlignment="Center" ToolTip="{Binding AutostartTip}" />
                    <CheckBox Content="Ask to keep changes after a hotkey or tray switch" IsChecked="{Binding ConfirmAfterHotkey}"
                              Margin="0,0,24,6" VerticalAlignment="Center"
                              ToolTip="Shows the 15-second keep-or-revert prompt, like Test does" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox Content="When a display is plugged in, apply" IsChecked="{Binding OnConnectEnabled}"
                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectedItem="{Binding OnConnectPreset}"
                                  IsEnabled="{Binding OnConnectEnabled}" MinWidth="150" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Save" Click="Save_Click" IsDefault="True" />
                <Button Content="Close" Click="Close_Click" Margin="0" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
